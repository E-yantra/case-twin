# Local OpenAI-compatible gateway (e.g. LiteLLM) — chat, vision, embeddings, rerank
LOCAL_GATEWAY_BASE_URL=http://<gateway-host>:8000/v1
LOCAL_GATEWAY_API_KEY=
# notes -> structured case report (shared service: keep batch load low)
GEMMA_MODEL=gemma-4
# image reads, term explanations, synthesis, twin chat
MEDGEMMA_MODEL=medgemma
# two-image comparison (Run AI Analysis)
MEDGEMMA_COMPARISON_MODEL=medgemma
# chest X-ray finding boxes
MEDGEMMA_LOCALIZATION_MODEL=medgemma-1.5
# case-report embeddings
TEXT_EMBEDDING_MODEL=qwen3-embedding-8b
# cross-encoder reranking
RERANK_MODEL=bge-reranker-v2-m3

# Direct local MedSigLIP service (image/text embeddings, zero-shot classify)
MEDSIGLIP_BASE_URL=http://<medsiglip-host>:30021
MEDSIGLIP_API_KEY=

# Local Qdrant (Compose overrides the URL). Leave the key empty for a local container.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=multicare_cases
# Empty = <repo>/dataset
DATASET_DIR=

# Browser origins exposed by docker-compose's frontend service
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
